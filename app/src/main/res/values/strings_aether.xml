    <string name="aether_transport_mim">MIM (MASQUE in MASQUE)</string>
    <string name="aether_scan_mode">Scan mode</string>
    <string name="aether_scan_turbo">turbo — first answer</string>
    <string name="aether_scan_balanced">balanced — fastest few (default)</string>
    <string name="aether_scan_thorough">thorough — full sweep</string>
    <string name="aether_scan_verified">verified — data-plane check</string>
