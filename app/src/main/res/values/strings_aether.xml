    <!-- Aether strings - replaces Coming Soon placeholders with real controls -->
    <string name="aether_coming_soon_title">Aether — Next-Gen Transport</string>
    <string name="aether_coming_soon_body">Aether discovers reachable gateways, opens an encrypted tunnel (MASQUE/WireGuard) and exposes a local SOCKS5 proxy. Configure transport, scan mode and bind address, then start.</string>
    <string name="aether_no_effect">Aether runs independently from RSTA; it has its own identity and tunnel. Switch cores to control each engine separately.</string>
    <string name="aether_feature_1">MASQUE (HTTP/3 &amp; H2) + WireGuard, nested Gool/MIM</string>
    <string name="aether_feature_2">Endpoint discovery + data-plane validation + obfuscation</string>
    <string name="aether_feature_3">Local SOCKS5 (127.0.0.1:1819) + optional HTTP proxy</string>

