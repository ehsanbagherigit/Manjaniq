    <!-- Transport / protocol detail lines -->
    <string name="aether_transport_masque_detail">MASQUE over QUIC/HTTP-3. The Aether default.</string>
    <string name="aether_transport_wg_detail">Classic WireGuard to a WARP endpoint on UDP 2408.</string>
    <string name="aether_transport_gool_detail">WireGuard carried inside MASQUE, for a foreign exit address.</string>
    <string name="aether_transport_mim_detail">MASQUE inside MASQUE: two hops, a different exit address.</string>
    <string name="aether_transport_unreachable">Aether supports this protocol, but aether_tunnel_start parses only masque and wg (api::Transport), so it would silently run as plain MASQUE. It needs the aether_core_start path.</string>

