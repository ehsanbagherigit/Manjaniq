    <!-- Fragmenting -->
    <string name="section_fragmenting">Fragmenting</string>
    <string name="aether_fragment_title">Fragment the TLS ClientHello</string>
    <string name="aether_fragment_desc">Aether splits the ClientHello of the MASQUE HTTP/2 carrier into small pieces with a delay between them, so a firewall that resets a whole ClientHello whose SNI ends in cloudflareclient.com does not see one. Implemented in aether/src/fragment.rs.</string>
    <string name="aether_fragment_enable">Fragmenting on</string>
    <string name="aether_fragment_enable_desc">Off by default in Aether. Applies to the HTTP/2 carrier only, never to QUIC or WireGuard, so turning it on also selects that carrier.</string>
    <string name="aether_fragment_size">Chunk size (bytes)</string>
    <string name="aether_fragment_size_hint">n or a-b, for example 16-32 (the Aether default)</string>
    <string name="aether_fragment_delay">Delay between fragments (ms)</string>
    <string name="aether_fragment_delay_hint">n or a-b, for example 2-10 (the Aether default)</string>
    <string name="aether_fragment_sni">Split inside the server name</string>
    <string name="aether_fragment_sni_desc">AETHER_MASQUE_H2_FRAGMENT_SNI: put the split in the middle of the SNI host name instead of at a random offset. Upstream has no CLI flag for it, so it reaches Aether only through this app\u2019s bridge.</string>
    <string name="aether_fragment_status_on">Applied — this route runs MASQUE over HTTP/2</string>
    <string name="aether_fragment_status_off">Off — this route runs MASQUE over HTTP/3 (QUIC)</string>
    <string name="aether_fragment_carrier_switch">Turning fragmenting on switches this route\u2019s MASQUE carrier from HTTP/3 (QUIC) to HTTP/2 (TCP), because the fragments are written into that carrier\u2019s TLS ClientHello (aether/src/masque_h2.rs). The scan and the tunnel both follow the carrier, so nothing is left half applied.</string>
    <string name="aether_fragment_needs_masque">These values are stored with the route and sent to Aether, which writes the fragments into the MASQUE-over-HTTP/2 carrier\'s ClientHello only. This route uses %1$s, so the tunnel carries the setting without using it.</string>
    <string name="aether_fragment_saved">Fragmenting saved with the route; Aether applies it on the next start.</string>
    <string name="aether_fragment_saved_restart">Fragmenting saved; Aether is restarting with it.</string>
    <string name="aether_fragment_scope">One carrier only: MASQUE over HTTP/2. Turning fragmenting on selects that carrier for you - on masque, gool and mim alike - and turning it off selects QUIC again. WireGuard has no such carrier, so a WireGuard route carries the setting without using it.</string>
    <string name="aether_fragment_recorded_for">Stored with the selected route (%1$s) and applied when that route starts:</string>
    <string name="aether_fragment_recorded_none">No route is selected, so these are the values stored with the Aether configuration:</string>
    <string name="aether_psiphon_enable">Chain through Psiphon</string>
        <string name="aether_fragment_how_to_change">These values are stored with the route, appear in its exported JSON, and are written into the engine\u2019s environment before each start — Aether reads them per connection (aether/src/fragment.rs).</string>
    <string name="aether_fragment_env_label">Aether reads: %1$s</string>




