    <!-- Fragmenting -->
    <string name="section_fragmenting">Fragmenting</string>
    <string name="aether_fragment_title">Fragment the TLS ClientHello</string>
    <string name="aether_fragment_desc">Aether splits the ClientHello of the MASQUE HTTP/2 carrier into small pieces with a delay between them, so a firewall that resets a whole ClientHello whose SNI ends in cloudflareclient.com does not see one. Implemented in aether/src/fragment.rs.</string>
    <string name="aether_fragment_enable">Fragmenting on</string>
    <string name="aether_fragment_enable_desc">Off by default in Aether. Applies to the HTTP/2 carrier only, never to QUIC or WireGuard.</string>
    <string name="aether_fragment_size">Chunk size (bytes)</string>
    <string name="aether_fragment_size_hint">n or a-b, for example 16-32 (the Aether default)</string>
    <string name="aether_fragment_delay">Delay between fragments (ms)</string>
    <string name="aether_fragment_delay_hint">n or a-b, for example 2-10 (the Aether default)</string>
    <string name="aether_fragment_sni">Split inside the server name</string>
    <string name="aether_fragment_sni_desc">AETHER_MASQUE_H2_FRAGMENT_SNI: put the split in the middle of the SNI host name instead of at a random offset. Environment-only upstream, it has no CLI flag.</string>
    <string name="aether_fragment_status_blocked">Recorded, not applied in this build</string>
    <string name="aether_psiphon_enable">Chain through Psiphon</string>
        <string name="aether_fragment_how_to_change">These values are stored with the route and appear in its exported JSON. They are shown read-only because editing them here would change nothing until Aether is started through its CLI path.</string>
    <string name="aether_fragment_env_label">Aether reads: %1$s</string>

    <!-- Reachability reasons (AetherCapabilities) -->
    <string name="aether_reach_applied_transport">Sent to aether_identity_open, aether_scan_start and aether_tunnel_start.</string>
    <string name="aether_reach_applied_scan">Sent as ScanRequest.mode; prober::ScanMode parses it.</string>
    <string name="aether_reach_applied_ip">Sent as ScanRequest.ip; prober::IpScan parses v4, v6 and both.</string>
    <string name="aether_reach_applied_socks">Sent as TunnelSpec.socks; Aether binds the SOCKS5 listener there.</string>
    <string name="aether_reach_applied_http">Sent as TunnelSpec.http; Aether also serves an HTTP CONNECT proxy there.</string>
    <string name="aether_reach_applied_peer">Used instead of scanning; sent as the tunnel peer.</string>
    <string name="aether_reach_applied_identity">Resolved inside the app private directory and sent to aether_identity_open.</string>
    <string name="aether_reach_partial_ech">Applied for MASQUE only: ffi::job_ech returns no key for WireGuard, which has no TLS handshake to hide a name in.</string>
    <string name="aether_reach_partial_noize">Applied to the scan (noize::from_profile) and to a WireGuard tunnel (aethernoize::from_profile), but not to a MASQUE tunnel, which reads its profile from AETHER_NOIZE — a variable this path cannot set. The two parsers also differ: the scan has no balanced case, so balanced scans as firewall.</string>
    <string name="aether_reach_partial_team">The team name is sent, but enrolment also needs a service token or a one-time code. The aether_team_* calls are wired in AetherBridge and are not used by this screen yet.</string>
    <string name="aether_reach_missing_env_only">Aether reads this from its own environment (set by the CLI). No field for it exists on aether_tunnel_start, and Android has no public API for setting the process environment, so the value is saved and shown but not applied.</string>
    <string name="aether_reach_missing_cli_flow">Only the aether_core_start CLI flow acts on this; the identity/scan/tunnel path this build uses has no field for it.</string>
    <string name="aether_reach_missing_fragment">Fragmenting is configured through AETHER_MASQUE_H2_FRAGMENT and friends, or the --fragment flags. Neither reaches aether_tunnel_start, so the value is saved and shown but not applied.</string>
    <string name="aether_reach_missing_external">Needs a Tor or Psiphon component that is not bundled with this build, and this path forwards no Tor or Psiphon setting.</string>

